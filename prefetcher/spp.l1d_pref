#include "cache.h"
#include <algorithm>
#include <cstring>
#include <vector>
#include <functional>

#define IP_TRACKER_COUNT 24
#define MASK_IP 0xFF
#define PAST_STRIDES 7

#define CONF_MAX          3    // saturating counter ceiling
#define CONF_MIN          0    // saturating counter floor
#define CONF_HIGH_THRESH  2    // confidence >= this -> aggressive
#define CONF_LOW_THRESH   1    // confidence <= this -> minimal
#define DEGREE_HIGH       4
#define DEGREE_MED        3    
#define DEGREE_LOW        1

class LRU_Element {
public:
    int8_t lru;
    uint64_t unique_id;

    LRU_Element(uint64_t unique_id) : unique_id(unique_id),
                                      lru(0) {}

    // Virtual destructor added to ensure proper cleanup of derived classes
    virtual ~LRU_Element() = default;
};

template <typename T>
class LRU_Block {
private:
    int size;
    std::vector<T *> elements;

public:
    LRU_Block(int s) : size(s) {
        // Initializes with nullptrs
        elements = std::vector<T *>(size, nullptr);
    }

    // CHANGED: Added a destructor to clean up dynamically allocated elements
    // when a tracker is evicted or destroyed.
    ~LRU_Block() {
        for (auto elem : elements) {
            if (elem)
                delete elem;
        }
    }

    // CHANGED: Added getter to safely iterate over elements during prefetch generation
    const std::vector<T *> &get_elements() const {
        return elements;
    }

    // First Element: Pointer to the element with the unique_id
    // Second Element: True if the element was newly inserted, False if it already existed
    std::pair<T *, bool> insert(uint64_t unique_id) {
        int index = 0;

        // 1. Search for existing element
        for (index = 0; index < size; index++) {
            if (elements[index] && elements[index]->unique_id == unique_id) {
                break; // Found it!
            }
        }

        // 2. Element not found, we need to insert and potentially evict
        if (index == size) {
            int victim_idx = -1;

            // CHANGED: Safely find an empty slot OR the LRU victim
            for (int i = 0; i < size; i++) {
                if (!elements[i]) {
                    victim_idx = i; // Found an empty slot!
                    break;
                }
                if (elements[i]->lru == (size - 1)) {
                    victim_idx = i; // Found the LRU victim
                }
            }

            // Free the memory of the evicted element if the slot wasn't empty
            if (elements[victim_idx]) {
                delete elements[victim_idx];
            }

            elements[victim_idx] = new T(unique_id);
            index = victim_idx; // Set index to our newly inserted element

            // Update LRUs: Since we inserted a new Most Recently Used (MRU = 0),
            // all other existing elements age by 1.
            for (int i = 0; i < size; i++) {
                if (elements[i] && i != index && elements[i]->lru < size - 1) {
                    elements[i]->lru++;
                }
            }

            elements[index]->lru = 0;
            return std::make_pair(elements[index], true);
        }

        // 3. Element was found! We just need to update LRU states.
        // CHANGED: Only age elements that are currently more recently used than the accessed element.
        int current_lru = elements[index]->lru;
        for (int i = 0; i < size; i++) {
            if (elements[i] && elements[i]->lru < current_lru) {
                elements[i]->lru++;
            }
        }

        elements[index]->lru = 0; // Accessed element becomes MRU
        return std::make_pair(elements[index], false);
    }
};

class Stride_Element : public LRU_Element {
public:
    // CHANGED: Removed the `uint64_t& stride` reference. References inside objects
    // prevent implicit assignment operators. Instead, we use a helper function to
    // cast the unsigned unique_id back to a signed integer.
    LRU_Block<Stride_Element> next_strides;

    // NEW: per-edge saturating confidence counter. Lives directly on the edge
    // this stride represents, so "how trustworthy is this specific predicted
    // transition" is tracked locally, with zero extra containers.
    int8_t confidence;

    Stride_Element(uint64_t id) : LRU_Element(id),
                                  next_strides(3),
                                  confidence(0) {}

    int64_t get_stride_val() const {
        return static_cast<int64_t>(unique_id);
    }
};

class Tracker_Element : public LRU_Element {
public:
    uint64_t last_cl_addr;
    Stride_Element *last_stride;
    LRU_Block<Stride_Element> strides;

    // NEW: what we predicted would be the *next* stride, so we can check it
    // against reality on the following access and adjust that edge's confidence.
    int64_t predicted_stride;
    bool has_prediction;

    Tracker_Element(uint64_t id) : LRU_Element(id),
                                   last_cl_addr(0),
                                   last_stride(nullptr),
                                   strides(PAST_STRIDES),
                                   predicted_stride(0),
                                   has_prediction(false) {}
};

// Global Table
LRU_Block<Tracker_Element> trackers(IP_TRACKER_COUNT);

void CACHE::l1d_prefetcher_initialize() {
    cout << "CPU " << cpu << " L1D Stride Pattern Prefetcher (per-edge confidence throttling)" << endl;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag) {
    // Cache Line Index
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

    // Strip the IP down to a smaller size to reduce the number of trackers we need to maintain
    ip = ip & MASK_IP;

    auto tracker_result = trackers.insert(ip);
    Tracker_Element* tracker = tracker_result.first;
    bool is_new_tracker = tracker_result.second;

    if (is_new_tracker) {
        tracker->last_cl_addr = cl_addr;
        tracker->last_stride = nullptr;
        tracker->has_prediction = false;
        return;
    }

    // Calculate stride
    int64_t stride = static_cast<int64_t>(cl_addr) - static_cast<int64_t>(tracker->last_cl_addr);

    // No spatial movement, nothing to prefetch or learn.
    if (stride == 0) {
        return;
    }

    // Before touching last_stride for this access, check whether what we
    // predicted last time actually happened, and adjust that edge's
    // confidence accordingly.
    if (tracker->has_prediction && tracker->last_stride != nullptr) {
        bool correct = (stride == tracker->predicted_stride);

        for (auto edge : tracker->last_stride->next_strides.get_elements()) {
            if (edge && edge->get_stride_val() == tracker->predicted_stride) {
                if (correct) {
                    if (edge->confidence < CONF_MAX) edge->confidence++;
                } else {
                    if (edge->confidence > CONF_MIN) edge->confidence--;
                }
                break;
            }
        }
    }

    auto stride_result = tracker->strides.insert(stride);
    Stride_Element* stride_element = stride_result.first;

    // Link the previous stride to this stride (Learning phase)
    if(tracker->last_stride != nullptr) {
        tracker->last_stride->next_strides.insert(stride);
    }

    // Update the tracker for the NEXT access
    tracker->last_cl_addr = cl_addr;
    tracker->last_stride = stride_element;

    // --- PREFETCH GENERATION (DFS Lookahead Mechanism) ---

    int prefetches_issued = 0;
    std::function<void(Stride_Element*, uint64_t, int)> dfs_lookahead;

    // Recursive lambda for DFS traversal. `degree_budget` is the per-call
    // throttled degree, derived from the confidence of the edge being followed.
    dfs_lookahead = [&](Stride_Element* current_state, uint64_t current_spec_cl, int degree_budget) -> void {
        // Base case: Stop if we've reached our (confidence-derived) prefetch budget
        if (prefetches_issued >= degree_budget) {
            return;
        }

        // 1. Gather all valid outgoing edges (next strides)
        std::vector<Stride_Element*> next_edges;
        for (auto ns : current_state->next_strides.get_elements()) {
            if (ns) {
                next_edges.push_back(ns);
            }
        }

        // 2. Sort edges by LRU (ascending).
        // This ensures we always try the most confident (lowest LRU) path first.
        std::sort(next_edges.begin(), next_edges.end(), [](Stride_Element* a, Stride_Element* b) {
            return a->lru < b->lru;
        });

        // 3. Traverse the sorted edges
        for (auto edge : next_edges) {
            if (prefetches_issued >= degree_budget) {
                break;
            }

            // NEW: let this specific edge's confidence set its own degree
            // budget. A low-confidence edge gets throttled on the spot
            // instead of relying on one global accuracy number.
            int edge_degree = (edge->confidence >= CONF_HIGH_THRESH) ? DEGREE_HIGH
                             : (edge->confidence <= CONF_LOW_THRESH)  ? DEGREE_LOW
                                                                      : DEGREE_MED;
            int effective_budget = std::min(degree_budget, edge_degree);
            if (prefetches_issued >= effective_budget) {
                continue; // this low-confidence edge is throttled away; try the next one
            }

            int64_t next_stride_val = edge->get_stride_val();
            uint64_t next_spec_cl = current_spec_cl + next_stride_val;
            uint64_t pf_addr = next_spec_cl << LOG2_BLOCK_SIZE;

            // Check Page Boundary
            if ((pf_addr >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE)) {
                // Instead of aborting the whole lookahead, we backtrack and try
                // the next best stride in our sorted list.
                continue;
            }

            // Issue the prefetch
            if (MSHR.occupancy < (MSHR.SIZE >> 1)) {
                prefetch_line(ip, addr, pf_addr, FILL_L1, 0);
            } else {
                prefetch_line(ip, addr, pf_addr, FILL_L2, 0);
            }

            prefetches_issued++;

            // Remember this as the prediction to verify on the tracker's NEXT access
            // (only the immediate next-level guess is checkable this way).
            if (current_state == stride_element) {
                tracker->predicted_stride = next_stride_val;
                tracker->has_prediction = true;
            }

            // 4. Find the state corresponding to this stride to continue DFS
            Stride_Element* next_state = nullptr;
            for (auto s : tracker->strides.get_elements()) {
                if (s && s->get_stride_val() == next_stride_val) {
                    next_state = s;
                    break;
                }
            }

            // 5. Recurse deeper into the graph.
            // If next_state is null, the recursion won't happen, the loop continues,
            // and we naturally BACKTRACK to the next edge in `next_edges`.
            if (next_state) {
                dfs_lookahead(next_state, next_spec_cl, effective_budget);
            }
        }
    };

    // If this access produced no outgoing edges to predict from, clear the
    // pending prediction so a stale guess isn't checked next time.
    if (stride_element->next_strides.get_elements().empty()) {
        tracker->has_prediction = false;
    }

    // Kick off the DFS from the current stride state, starting from the
    // original (unthrottled) ceiling; individual edges throttle themselves.
    dfs_lookahead(stride_element, cl_addr, DEGREE_HIGH);
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in) {
    return;
}

void CACHE::l1d_prefetcher_final_stats() {
}